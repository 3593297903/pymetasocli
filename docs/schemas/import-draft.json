{
  "$defs": {
    "Cue": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Cue",
      "type": "object"
    },
    "DraftSegment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "start": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "End",
          "type": "integer"
        },
        "duration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "gt": 0,
          "le": 15,
          "title": "Duration"
        },
        "prompt": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 9,
          "title": "References",
          "type": "array"
        },
        "parameters": {
          "$ref": "#/$defs/Parameters"
        },
        "narration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Narration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "duration"
      ],
      "title": "DraftSegment",
      "type": "object"
    },
    "Narration": {
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Assetid",
          "type": "string"
        },
        "cues": {
          "items": {
            "$ref": "#/$defs/Cue"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Cues",
          "type": "array"
        }
      },
      "required": [
        "assetId",
        "cues"
      ],
      "title": "Narration",
      "type": "object"
    },
    "Parameters": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "MiniMax-H3",
          "default": "MiniMax-H3",
          "title": "Model",
          "type": "string"
        },
        "resolution": {
          "default": "768P",
          "enum": [
            "768P",
            "2K"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "ratio": {
          "default": "9:16",
          "enum": [
            "adaptive",
            "21:9",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ],
          "title": "Ratio",
          "type": "string"
        },
        "contextIr": {
          "default": true,
          "title": "Contextir",
          "type": "boolean"
        },
        "watermark": {
          "default": false,
          "title": "Watermark",
          "type": "boolean"
        }
      },
      "title": "Parameters",
      "type": "object"
    },
    "Recipe": {
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Assetid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "character",
            "scene",
            "prop",
            "first_frame",
            "narration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "prompt": {
          "maxLength": 32000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "exactText": {
          "items": {
            "type": "string"
          },
          "title": "Exacttext",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        }
      },
      "required": [
        "assetId",
        "kind",
        "prompt"
      ],
      "title": "Recipe",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Assetid",
          "type": "string"
        },
        "role": {
          "enum": [
            "reference_image",
            "first_frame"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "assetId",
        "role"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "episodeId": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Episodeid",
      "type": "string"
    },
    "kind": {
      "enum": [
        "script",
        "video-prompts"
      ],
      "title": "Kind",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "offsetEncoding": {
      "const": "utf16",
      "default": "utf16",
      "title": "Offsetencoding",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/DraftSegment"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "recipes": {
      "items": {
        "$ref": "#/$defs/Recipe"
      },
      "maxItems": 2000,
      "title": "Recipes",
      "type": "array"
    }
  },
  "required": [
    "episodeId",
    "kind",
    "source",
    "segments"
  ],
  "title": "ImportDraft",
  "type": "object"
}
